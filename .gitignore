# WeatherGuard .gitignore

# Datasets and large derived files
*.parquet
yolov8n.pt
yolo*.pt

# Generated runtime logs (kept on disk, not in git)
artifacts/*.log

# Generated machine-readable experiment outputs are tracked:
#   artifacts/*.json, artifacts/*.csv
#   artifacts/plots/*.png
# These are the inputs the dashboard reads and they are small enough
# (the largest is ~18 MB).

# Large per-image prediction gallery (kept on disk for local use)
artifacts/qualitative/

# Virtual environment
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent / IDE session state (not part of the project)
.commandcode/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Streamlit
.streamlit/secrets.toml
